# ---- Tier 1: InfiniSynapse Server API key (Bearer token) ----
# Get one at https://app.infinisynapse.cn -> Settings (gear) -> API Key Management -> Create API Key
# IMPORTANT: keys are server-side ONLY. Never put them in frontend code or commit them.
INFINISYNAPSE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Tier 2: Favor API key (OpenAI-compatible, used for the qwen3-max CEO role) ----
FAVOR_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# INFINISYNAPSE_SERVER=https://app.infinisynapse.cn
# FAVOR_SERVER=https://api.favorais.com/v1
# CEO_MODEL=qwen3-max
# PORT=8787
# AGENT_TIMEOUT_MS=150000
